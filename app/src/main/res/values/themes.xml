<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DevilCam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ds_bg</item>
        <item name="android:statusBarColor">@color/ds_bg</item>
        <item name="android:navigationBarColor">@color/ds_bg</item>
        <item name="android:colorAccent">@color/ds_red</item>
    </style>

    <style name="Theme.DevilCam.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/ds_red_light</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#FFC8CDD3</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DevilCam.DialogButton.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DevilCam.DialogButton</item>
    </style>

    <style name="DevilCam.DialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#FFAEB4BC</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DevilCam.DialogButton.Positive">
        <item name="android:textColor">@color/ds_red_light</item>
    </style>
</resources>
